# =====================================================================
# LaundryOS API - biến môi trường (mẫu: copy thành .env rồi điền secret)
# Dùng cho: docker compose (docker-compose.yml) và run-be.ps1 (chạy ngoài docker).
# Khi chạy trong docker, DB_URL/DB_USERNAME/DB_PASSWORD/MQTT_HOST/MQTT_PORT bị compose ghi đè.
# =====================================================================

# ---- PostgreSQL ----
POSTGRES_DB=sslos
POSTGRES_USER=sslos
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432

# Backend chạy ngoài docker (run-be.ps1). Phải trùng mật khẩu ở trên.
DB_URL=jdbc:postgresql://localhost:5432/sslos
DB_USERNAME=sslos
DB_PASSWORD=change-me

# ---- Backend ----
BACKEND_HOST_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---- JWT ----
JWT_SECRET=change-me
JWT_ISSUER=sslos-api
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800
PASSWORD_RESET_TOKEN_EXPIRATION=900

# Tài khoản quản trị tạo lần đầu (để trống = không tạo)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- MQTT / EMQX ----
MQTT_HOST=localhost
MQTT_PORT=1883
# Cổng TLS trả cho bo mạch trong câu trả lời đăng ký (POST /api/devices/register)
MQTT_DEVICE_TLS_PORT=8883
# Tài khoản superuser của backend trên broker (backend tự ghi vào mqtt_accounts khi khởi động)
MQTT_BACKEND_USERNAME=sslos-backend
MQTT_BACKEND_PASSWORD=change-me
# Role DB chỉ-đọc mà EMQX dùng để kiểm tài khoản bo mạch
EMQX_AUTH_DB_PASSWORD=change-me
EMQX_DASHBOARD_PASSWORD=change-me
EMQX_NODE_COOKIE=change-me
# Tên/IP của máy chủ cửa hàng ghi vào chứng chỉ TLS của broker (sinh một lần)
EMQX_TLS_SAN=DNS:localhost,IP:127.0.0.1,IP:192.168.1.10

# ---- payOS ----
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/return
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# Cổng nhận chuyển khoản: payos (mặc định) hoặc sepay
PAYMENT_GATEWAY=payos
# Cổng thanh toán SePay (my.sepay.vn → Cổng thanh toán): sandbox | production
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Khóa IPN tự đặt ở Cổng thanh toán → Cấu hình → IPN (xác thực SECRET_KEY); URL IPN: <backend công khai>/api/payments/sepay/ipn
SEPAY_IPN_SECRET_KEY=
# Địa chỉ backend khách mở được (kiosk cần địa chỉ LAN, vd http://192.168.1.4:8080)
SEPAY_PUBLIC_BASE_URL=http://localhost:8080

# ---- Email ----
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
EMAIL_FROM=noreply@sslos.com