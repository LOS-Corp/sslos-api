# ============================================================
# LaundryOS API — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git!
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/sslos
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# ── JWT ──────────────────────────────────────────────────────
# Must be at least 32 characters (256-bit) for HS256
JWT_SECRET=change-this-to-a-very-long-random-secret-at-least-32-bytes!!
JWT_ISSUER=sslos-api
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# ── Auth ─────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRATION=900

# ── Transaction ──────────────────────────────────────────────
TRANSACTION_EXPIRATION_MINUTES=15

# ── Payment Gateway ──────────────────────────────────────────
PAYMENT_GATEWAY=payos
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_BASE_URL=https://api.payos.vn
PAYOS_CALLBACK_URL=https://your-domain.com/api/payments/payos/webhook

# Public customer-app base URL used by printed machine QR labels
QR_BASE_URL=https://your-customer-app.example.com

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Email (SMTP) ─────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_AUTH=true
SMTP_STARTTLS=true
EMAIL_FROM=noreply@sslos.com

# ── MQTT / EMQX Cloud ────────────────────────────────────────
# Get these from your EMQX Cloud deployment page.
# NEVER put real credentials here — fill in .env only.
MQTT_BROKER_HOST=your-cluster-id.emqxsl.com
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=sslos-backend-001
MQTT_USE_TLS=true
MQTT_CONNECTION_TIMEOUT_SECONDS=30
MQTT_KEEP_ALIVE_SECONDS=60
MQTT_CLEAN_SESSION=true
MQTT_COMMAND_QOS=1

# ── Machine / IoT Settings ───────────────────────────────────
# Seconds without heartbeat before machine is marked OFFLINE
MACHINE_HEARTBEAT_TIMEOUT_SECONDS=30
# Seconds to wait for command ACK before marking TIMEOUT
MACHINE_COMMAND_TIMEOUT_SECONDS=15
