# ============================================================
# LaundryOS API — Environment Variables (optional overrides)
# Local runs read src/main/resources/application-dev.properties (profile dev, the default);
# deployments read application-prod.properties (profile prod). Both are git-ignored.
# Any variable below, when set in the environment (Docker, /opt/sslos/api.env on the VPS),
# overrides the value in the profile file. NEVER commit real values to Git!
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/sslos
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# ── JWT ──────────────────────────────────────────────────────
# Must be at least 32 characters (256-bit) for HS256
JWT_SECRET=change-this-to-a-very-long-random-secret-at-least-32-bytes!!
JWT_ISSUER=sslos-api
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# ── Auth ─────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRATION=900

# ── Transaction ──────────────────────────────────────────────

# ── Payment Gateway ──────────────────────────────────────────
PAYMENT_GATEWAY=payos
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_BASE_URL=https://api.payos.vn
PAYOS_CALLBACK_URL=https://your-domain.com/api/payments/payos/webhook

# Public customer-app base URL used by printed machine QR labels
QR_BASE_URL=https://your-customer-app.example.com

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Email (SMTP) ─────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_AUTH=true
SMTP_STARTTLS=true
EMAIL_FROM=noreply@sslos.com

# ── Machine / IoT Settings ───────────────────────────────────
# Seconds without heartbeat before machine is marked OFFLINE
MACHINE_HEARTBEAT_TIMEOUT_SECONDS=30
# Seconds to wait for command ACK before marking TIMEOUT
MACHINE_COMMAND_TIMEOUT_SECONDS=15

# ── ESP32 boards on the store Wi-Fi (local EMQX broker, LAN only) ──
# The only device link. Topics: laundryos/v1/devices/<deviceId>/{presence | up/<channel> | down/<channel>}.
# Boards are set up on their access point "LaundryOS-Setup-XXXX" (http://192.168.4.1).
# false only on a machine without a broker (e.g. a dev laptop): boards then stay offline.
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://localhost:1883
# EMQX REST API key (same values as MQTT_API_KEY / MQTT_API_SECRET of the emqx service).
MQTT_API_URL=http://localhost:18083
MQTT_API_KEY=change-this-api-key
MQTT_API_SECRET=change-this-api-secret
MQTT_USERNAME=laundryos-server
MQTT_PASSWORD=change-this-broker-password-of-the-backend
# Shown to the admin (Thiet bi IoT > Ket noi Wi-Fi) to type into a board's setup page:
# the store server's LAN address (boards register on it and get their own MQTT account).
MQTT_DEVICE_HOST=192.168.1.10
# The boards connect over TLS; the backend itself uses MQTT_BROKER_URL (plain, local).
MQTT_DEVICE_PORT=8883
# This API's port as the boards reach it (they register here for their own MQTT account).
MQTT_DEVICE_API_PORT=8080
